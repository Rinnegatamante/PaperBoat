	src/world/area_sbk/sbk_35 src/world/area_sbk/sbk_36 src/world/area_sbk/sbk_40 src/world/area_sbk/sbk_41 src/world/area_sbk/sbk_42 \
	src/world/area_sbk/sbk_43 src/world/area_sbk/sbk_44 src/world/area_sbk/sbk_45 src/world/area_sbk/sbk_46 src/world/area_sbk/sbk_50 \
	src/world/area_sbk/sbk_51 src/world/area_sbk/sbk_52 src/world/area_sbk/sbk_53 src/world/area_sbk/sbk_54 src/world/area_sbk/sbk_55 \
	src/world/area_sbk/sbk_56 src/world/area_sbk/sbk_60 src/world/area_sbk/sbk_61 src/world/area_sbk/sbk_62 src/world/area_sbk/sbk_63 \
	src/world/area_sbk/sbk_64 src/world/area_sbk/sbk_65 src/world/area_sbk/sbk_66 src/world/area_sbk/sbk_99 src/world/area_tik/common \
	src/world/area_tik/tik_01 src/world/area_tik/tik_02 src/world/area_tik/tik_03 src/world/area_tik/tik_04 src/world/area_tik/tik_05 \
	src/world/area_tik/tik_06 src/world/area_tik/tik_07 src/world/area_tik/tik_08 src/world/area_tik/tik_09 src/world/area_tik/tik_10 \
	src/world/area_tik/tik_12 src/world/area_tik/tik_14 src/world/area_tik/tik_15 src/world/area_tik/tik_17 src/world/area_tik/tik_18 \
	src/world/area_tik/tik_19 src/world/area_tik/tik_20 src/world/area_tik/tik_21 src/world/area_tik/tik_22 src/world/area_tik/tik_23 \
	src/world/area_tik/tik_24 src/world/area_tik/tik_25 src/world/area_trd/trd_00 src/world/area_trd/trd_01 src/world/area_trd/trd_02 \
	src/world/area_trd/trd_03 src/world/area_trd/trd_04 src/world/area_trd/trd_05 src/world/area_trd/trd_06 src/world/area_trd/trd_07 \
	src/world/area_trd/trd_08 src/world/area_trd/trd_09 src/world/area_trd/trd_10 src/world/area_tst/tst_01 src/world/area_tst/tst_02 \
	src/world/area_tst/tst_03 src/world/area_tst/tst_04 src/world/area_tst/tst_10 src/world/area_tst/tst_11 src/world/area_tst/tst_12 \
	src/world/area_tst/tst_13 src/world/area_tst/tst_20 src/world/common/atomic src/world/common/complete src/world/common/enemy \
	src/world/common/enemy/ai src/world/common/entity src/world/common/lava_piranha src/world/common/npc src/world/common/todo src/world/common/util \
	src/world/model_anim/kzn src/world/partner src/world/script_api
SOURCES := $(LUS_SOURCES) $(TORCH_SOURCES) $(GAME_SOURCES)

INCLUDES := $(LUS_INCLUDES) $(TORCH_INCLUDES) ignored/assets/us ignored/include include include/libultra include/PR include/assets src/port src \
	actors levels include include/PR spdlog/include include/assets include/assets/actors \
	include/assets/assets include/assets/bin include/assets/levels include/assets/textures \
	src/audio src/buffers src/engine src/game src/goddard src/menu src/pc src/port src/port/Enhancements \
	src/port/enhancements/game-interactor src/port/api textures src .

LIBS = -lstorm -lgfxd -lzip -lbzip2 -lzstd -lz -lyaml-cpp -llzma -lssl -lcrypto -lstdc++ -lpng \
	-Wl,--whole-archive -lpthread -Wl,--no-whole-archive -lopenal \
	-ltinyxml2 -lSDL2 -lvorbisfile -lvorbis -logg $(VITAGL_LIB) -lvitashark -lSceShaccCgExt -ltaihen_stub -lmathneon -lSceAudioIn_stub \
	-lSceIme_stub -lSceKernelDmacMgr_stub -lSceGxm_stub -lSceDisplay_stub -lSceTouch_stub -lSceHid_stub -lSceCtrl_stub -lSceNet_stub \
	-lSceNetCtl_stub -lSceCommonDialog_stub -lSceAudio_stub -lSceSysmodule_stub -lSceMotion_stub -lSceAppUtil_stub \
	-lSceAppMgr_stub -lSceShaccCg_stub -lScePower_stub -lSceNpTrophy_stub

FINAL_SOURCES := f
OBJECT_RESPONSE := $(TARGET).objects.rsp
PORT_O2R := paperboat.o2r

CFILES := $(foreach dir,$(SOURCES), $(wildcard $(dir)/*.c)) $(LUS_ROOT)/imgui/backends/imgui_impl_opengl3.c $(LUS_ROOT)/imgui/backends/imgui_impl_sdl2.c
CPPFILES := $(foreach dir,$(SOURCES), $(wildcard $(dir)/*.cpp))

CFILES := $(filter-out %.inc.c, $(CFILES))
CFILES := $(filter-out bin/eu/%, $(CFILES))
CFILES := $(filter-out src/os/% src/boot/% src/effects/gfx/% %_jp.c %_fr.c %_es.c %_de.c %_en.c %_en_de.c %_pal.c %_ique.c, $(CFILES))
CFILES := $(filter-out %/unused_gfx.c %/filemenu_selectlanguage.c %/npc_composer.c %/npc_hint_dryite_companion.c %/npc_hint_dryite.c %/npc_merlee.c %/npc_moustafa.c %/npc_shop_owner.c, $(CFILES))
CFILES := $(filter-out %/kzn_19_anim%.c %/hos_10/narrator.c %/battle/area/sam2/dlist.c %/battle/area/sam2/vtx.c %/pra_02/entity.c, $(CFILES))
CPPFILES := $(filter-out %.inc.cpp, $(CPPFILES))

OBJS := $(CFILES:.c=.o) $(CPPFILES:.cpp=.o) \
	$(LUS_ROOT)/imgui/backends/imgui_impl_opengl3.o \
	$(LUS_ROOT)/imgui/backends/imgui_impl_sdl2.o

OBJS_PREPARE := $(CFILES:.c=.ok) $(CPPFILES:.cpp=.ok) \
	$(LUS_ROOT)/imgui/backends/imgui_impl_opengl3.ok \
	$(LUS_ROOT)/imgui/backends/imgui_impl_sdl2.ok

OBJS_CLEAN := $(CFILES:.c=.oc) $(CPPFILES:.cpp=.oc) \
	$(LUS_ROOT)/imgui/backends/imgui_impl_opengl3.oc \
	$(LUS_ROOT)/imgui/backends/imgui_impl_sdl2.oc

FINAL_OBJS := $(foreach dir,$(FINAL_SOURCES), $(wildcard $(dir)/*.o))

CVAR_PREFIX_RANDOMIZER_ENHANCEMENT := gRandoEnhancements
CVAR_PREFIX_RANDOMIZER_SETTING     := gRandoSettings
CVAR_PREFIX_COSMETIC               := gCosmetics
CVAR_PREFIX_AUDIO                  := gAudioEditor
CVAR_PREFIX_CHEAT                  := gCheats
CVAR_PREFIX_ENHANCEMENT            := gEnhancements
CVAR_PREFIX_SETTING                := gSettings
CVAR_PREFIX_WINDOW                 := gOpenWindows
CVAR_PREFIX_TRACKER                := gTrackers
CVAR_PREFIX_DEVELOPER_TOOLS        := gDeveloperTools
CVAR_PREFIX_GENERAL                := gGeneral
CVAR_PREFIX_REMOTE                 := gRemote
CVAR_PREFIX_GAMEPLAY_STATS         := gGameplayStats
CVAR_PREFIX_TIME_DISPLAY           := gTimeDisplay
PAPERBOAT_VITA_GIT_BRANCH          := $(shell git branch --show-current)
PAPERBOAT_VITA_GIT_COMMIT          := $(shell git rev-parse --short=7 HEAD)

PREFIX = arm-vita-eabi
CC  = $(PREFIX)-gcc
CXX = $(PREFIX)-g++

CFLAGS = -g -Wl,-q,--allow-multiple-definition,--wrap,pte_osSemaphorePost,--pic-veneer -O3 -ffast-math -fno-short-enums -fsigned-char \
	$(foreach dir,$(INCLUDES),-I$(dir)) -fno-strict-aliasing -fno-optimize-sibling-calls \
	-Wno-narrowing -DIMGUI_IMPL_OPENGL_ES2 -DSPDLOG_ACTIVE_LEVEL=6 \
	-I$(VITASDK)/$(PREFIX)/include/SDL2 -DENABLE_OPENGL=1 -DNON_EQUIVALENT=1 \
	-D_LANGUAGE_C -D_USE_MATH_DEFINES -DCIMGUI_DEFINE_ENUMS_AND_STRUCTS -DNAUDIO_SUPPORT \
	-DAVOID_UB=1 -DPAPERBOAT_ASSET_YAML_COUNT=235 -DPAPERBOAT_NATIVE_FILE_DIALOG=0 \
	-DPAPERBOAT_VITA_GIT_BRANCH=\"$(PAPERBOAT_VITA_GIT_BRANCH)\" -DPAPERBOAT_VITA_GIT_COMMIT=\"$(PAPERBOAT_VITA_GIT_COMMIT)\" \
	-DVERSION_US=1 -DVERSION=us -DPORT -DMODERN_COMPILER -D__CTX__ -DF3DEX_GBI_2 -DENABLE_RUMBLE=1 -DIMGUI_DEFINE_MATH_OPERATORS -DPM64_SUPPORT \
	-DCVAR_PREFIX_RANDOMIZER_ENHANCEMENT=\"$(CVAR_PREFIX_RANDOMIZER_ENHANCEMENT)\" \
	-DCVAR_PREFIX_RANDOMIZER_SETTING=\"$(CVAR_PREFIX_RANDOMIZER_SETTING)\" \
	-DCVAR_PREFIX_COSMETIC=\"$(CVAR_PREFIX_COSMETIC)\" \
	-DCVAR_PREFIX_AUDIO=\"$(CVAR_PREFIX_AUDIO)\" \
	-DCVAR_PREFIX_CHEAT=\"$(CVAR_PREFIX_CHEAT)\" \
	-DCVAR_PREFIX_ENHANCEMENT=\"$(CVAR_PREFIX_ENHANCEMENT)\" \
	-DCVAR_PREFIX_SETTING=\"$(CVAR_PREFIX_SETTING)\" \
	-DCVAR_PREFIX_WINDOW=\"$(CVAR_PREFIX_WINDOW)\" \
	-DCVAR_PREFIX_TRACKER=\"$(CVAR_PREFIX_TRACKER)\" \
	-DCVAR_PREFIX_DEVELOPER_TOOLS=\"$(CVAR_PREFIX_DEVELOPER_TOOLS)\" \
	-DCVAR_PREFIX_GENERAL=\"$(CVAR_PREFIX_GENERAL)\" \
	-DCVAR_PREFIX_REMOTE=\"$(CVAR_PREFIX_REMOTE)\" \
	-DCVAR_PREFIX_GAMEPLAY_STATS=\"$(CVAR_PREFIX_GAMEPLAY_STATS)\" \
	-DCVAR_PREFIX_TIME_DISPLAY=\"$(CVAR_PREFIX_TIME_DISPLAY)\" \
	-DCVAR_VSYNC_ENABLED=\"gVsyncEnabled\" \
	-DCVAR_Z_FIGHTING_MODE=\"gZFightingMode\" \
	-DCVAR_NEW_FILE_DROPPED=\"gNewFileDropped\" \
	-DCVAR_DROPPED_FILE=\"gDroppedFile\" \
	-DCVAR_INTERNAL_RESOLUTION=\"gInternalResolution\" \
	-DCVAR_MSAA_VALUE=\"gMSAAValue\" \
	-DCVAR_SDL_WINDOWED_FULLSCREEN=\"gSdlWindowedFullscreen\" \
	-DCVAR_TEXTURE_FILTER=\"gTextureFilter\" \
	-DCVAR_IMGUI_CONTROLLER_NAV=\"gControlNav\" \
	-DCVAR_CONSOLE_WINDOW_OPEN=\"gConsoleEnabled\" \
	-DCVAR_CONTROLLER_CONFIGURATION_WINDOW_OPEN=\"gControllerConfigurationEnabled\" \
	-DCVAR_CONTROLLER_DISCONNECTED_WINDOW_OPEN=\"gControllerDisconnectedWindowEnabled\" \
	-DCVAR_CONTROLLER_REORDERING_WINDOW_OPEN=\"gControllerReorderingWindowEnabled\" \
	-DCVAR_GFX_DEBUGGER_WINDOW_OPEN=\"gGfxDebuggerEnabled\" \
	-DCVAR_STATS_WINDOW_OPEN=\"gStatsEnabled\" \
	-DCVAR_ENABLE_MULTI_VIEWPORTS=\"gEnableMultiViewports\" \
	-DCVAR_LOW_RES_MODE=\"gLowResMode\" \
	-DCVAR_SIMULATED_INPUT_LAG=\"gSimulatedInputLag\" \
	-DCVAR_GAME_OVERLAY_FONT=\"gOverlayFont\" \
	-DCVAR_MENU_BAR_OPEN=\"gOpenMenuBar\" \
	-DCVAR_PREFIX_CONTROLLERS=\"gControllers\" \
	-DCVAR_PREFIX_ADVANCED_RESOLUTION=\"gAdvancedResolution\" \
	-DCVAR_AUDIO_CHANNELS_SETTING=\"gAudioChannelsSetting\" \
	-DCVAR_ALLOW_BACKGROUND_INPUTS=\"gAllowBackgroundInputs\" \
	-DCVAR_SCRIPT_SAFE_LEVEL=\"gScriptSafeLevel\"

CXXFLAGS = $(CFLAGS) -U_LANGUAGE_C -D_LANGUAGE_C_PLUS_PLUS -fexceptions -std=gnu++20 -fpermissive
ASFLAGS  = $(CFLAGS)

LUS_INSTALL_CONFIG := $(LUS_ROOT)/src/ship/install_config.h

$(LUS_INSTALL_CONFIG):
	@echo #define CMAKE_INSTALL_PREFIX "." > $@

$(OBJS): | $(LUS_INSTALL_CONFIG)

DEPFILES := $(OBJS:.o=.d)
-include $(DEPFILES)

%.o: %.c
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -MMD -MP -c -o $@ $<

.PHONY: all prepare objects port_archive debug-self

all: $(TARGET).vpk

$(TARGET).vpk: $(TARGET).velf port_archive $(DEBUG_SELF)
	vita-make-fself -c -s $< eboot.bin
	vita-mksfoex -s TITLE_ID=$(TITLE) -d ATTRIBUTE2=12 "$(TARGET)" param.sfo
	vita-pack-vpk -s param.sfo -b eboot.bin $(TARGET).vpk \
		-a livearea/icon0.png=sce_sys/icon0.png \
		-a livearea/bg.png=sce_sys/livearea/contents/bg.png \
		-a livearea/startup.png=sce_sys/livearea/contents/startup.png \
		-a livearea/template.xml=sce_sys/livearea/contents/template.xml \
		-a $(PORT_O2R)=$(PORT_O2R)

$(DEBUG_SELF): $(TARGET).velf $(VITA_MAKE_FSELF_DEBUG)
	$(PYTHON) $(VITA_MAKE_FSELF_DEBUG) "$<" "$(RAZOR_SELF)"

debug-self: $(DEBUG_SELF)

port_archive:
	@cd port && cmake -E tar cf ../$(PORT_O2R) --format=zip -- fonts textures

prepare: $(OBJECT_RESPONSE)

$(OBJECT_RESPONSE): $(OBJS)
	$(file >$@,$(OBJS))
	@echo Generated $@ with Vita object list

%.oc:
	@rm -rf $(@:c=)

%.velf: %.elf
	@copy /Y $< $<.unstripped.elf >nul
	$(PREFIX)-strip -g $<
	vita-elf-create $< $@

$(VITAGL_LIB):
	$(MAKE) -C $(VITAGL_DIR) -j8 $(VITAGL_FLAGS)

$(TARGET).elf: $(OBJECT_RESPONSE) $(VITAGL_LIB)
	$(CXX) $(CXXFLAGS) @$(OBJECT_RESPONSE) $(LIBS) -o $@

objects: $(OBJS)

clean: $(OBJS_CLEAN)
	@rm -rf $(TARGET).velf $(TARGET).elf $(TARGET).elf.unstripped.elf $(FINAL_OBJS) $(DEPFILES) $(OBJECT_RESPONSE) $(PORT_O2R) eboot.bin $(TARGET).vpk param.sfo $(RAZOR_SELF) $(DEBUG_SELF) $(LUS_INSTALL_CONFIG)

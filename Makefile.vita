TARGET := PaperBoat

TITLE := PAPERBOAT

PYTHON ?= python
VITA_MAKE_FSELF_DEBUG := tools/vita-make-fself-debug.py
RAZOR_SELF := $(TARGET)-razor.self
DEBUG_SELF := $(TARGET)-razor_debug.self

VITAGL_DIR ?= F:/Ubuntu/vitaGL-paperboat
VITAGL_FLAGS := HAVE_PTHREAD=1 NO_DEBUG=1 HAVE_GLSL_TEXTURE_SIZE=1 INDICES_SPEEDHACK=1
VITAGL_LIB := $(VITAGL_DIR)/libvitaGL.a
LUS_ROOT ?= libultraship

TORCH_INCLUDES := Torch/src Torch/src/utils Torch/lib Torch Torch/src/factories Torch/lib/n64graphics Torch/lib/binarytools

TORCH_SOURCES := Torch/src Torch/src/factories Torch/src/factories/pm64 Torch/lib/binarytools Torch/src/n64 Torch/src/preprocess Torch/src/types \
	Torch/src/utils Torch/lib/libmio0 Torch/src/archive Torch/lib/libyay0 Torch/lib/libyaz0 Torch/lib/n64graphics Torch/src/factories/naudio/v0 \
	Torch/src/factories/naudio/v1 Torch/lib/bk_zip

